# Connexion SQL Server 2022 Express (instance SQLEXPRESS2022, port 1433), authentification Windows
DATABASE_URL="sqlserver://localhost:1433;database=bd_stock_pharmacie;integratedSecurity=true;trustServerCertificate=true"

PORT=3005
# Plusieurs adresses possibles, séparées par des virgules (poste + téléphones sur le réseau)
CORS_ORIGIN=http://localhost:5173

# Authentification
JWT_SECRET=a_remplacer_par_une_longue_chaine_aleatoire
JWT_EXPIRATION=12h

# Compte administrateur créé par « npm run seed »
SEED_ADMIN_MATRICULE=ADMIN
SEED_ADMIN_MOT_DE_PASSE=a_definir
